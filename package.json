{
    "name": "trime-web",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "npm run dev -w trime-web-tool",
        "build": "node ./scripts/build-pages.mjs",
        "build:tool": "npm run package -w trime-web-core && npm run build -w trime-web-tool",
        "preview": "npm run preview -w trime-web-tool",
        "check": "npm run check -w trime-web-core && npm run check -w trime-web-tool",
        "lint": "prettier --check .",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "prettier": "^3.4.2",
        "prettier-plugin-svelte": "^3.3.2",
        "prettier-plugin-tailwindcss": "^0.6.9"
    }
}
